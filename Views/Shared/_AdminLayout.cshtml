@using Microsoft.AspNetCore.Identity
@using OneStopMobileRepair.Models
@inject OneStopMobileRepair.Models.AppDbContext _context
@inject UserManager<ApplicationUser> UserManager
@{
    var newEnquiryCount = _context.Enquiries.Count(x => x.Status == "New");
    var user = await UserManager.GetUserAsync(User);
    var adminName = string.IsNullOrEmpty(user?.FullName) ? "Administrator" : user.FullName;
    var avatarChar = adminName.Substring(0, 1).ToUpper();
    var avatarUrl = user?.ProfilePictureUrl;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | OneStop Mobile Repair</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">

    <!-- Ambient Background Blobs -->
    <div class="ambient-bg">
        <div class="amb-blob amb-blob-1"></div>
        <div class="amb-blob amb-blob-2"></div>
        <div class="amb-blob amb-blob-3"></div>
    </div>

    <div class="admin-wrapper">

        <!-- ═══════════ SIDEBAR ═══════════ -->
        <aside class="admin-sidebar" id="adminSidebar">

            <a class="sidebar-brand os-brand" asp-controller="Website" asp-action="Home">
                <div class="os-brand-img-wrap"><img src="~/images/logo.png" alt="OneStop Logo" /></div>
                <div class="os-brand-text">
                    <span class="brand-main">OneStop</span>
                    <span class="brand-sub">Mobile Repair &middot; Morbi</span>
                </div>
            </a>

            <nav class="sidebar-nav">
                <div class="nav-section-label">Main Menu</div>

                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <span class="link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    </span>
                    <span class="link-text">Dashboard</span>
                    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Home") {
                        <span class="link-pip"></span>
                    }
                </a>

                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Customers" asp-action="Index">
                    <span class="link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </span>
                    <span class="link-text">Customers</span>
                </a>

                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" && ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "active" : "")"
                   asp-controller="Customers" asp-action="Create">
                    <span class="link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                    </span>
                    <span class="link-text">Add Customer</span>
                </a>

                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" && ViewContext.RouteData.Values["Action"]?.ToString() == "Reminder" ? "active" : "")"
                   asp-controller="Customers" asp-action="Reminder">
                    <span class="link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    </span>
                    <span class="link-text">Reminders</span>
                </a>

                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Expenses" ? "active" : "")"
                   asp-controller="Expenses" asp-action="Index">
                    <span class="link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 15h0M2 9h20"/><path d="M12 12v3"/><path d="M12 15h3"/></svg>
                    </span>
                    <span class="link-text">Expenses</span>
                </a>

                <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Enquiries" ? "active" : "")"
                   asp-controller="Enquiries" asp-action="Index">
                    <span class="link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </span>
                    <span class="link-text">Enquiries</span>
                </a>

                <div class="nav-section-label" style="margin-top:12px">External</div>

                <a class="sidebar-link" asp-controller="Website" asp-action="Home" target="onestop_website">
                    <span class="link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    </span>
                    <span class="link-text">View Website</span>
                    <span style="font-size:10px;margin-left:auto;opacity:.5">↗</span>
                </a>
            </nav>

            <div class="sidebar-footer" style="flex-direction: column; align-items: stretch; gap: 10px;">
                <a class="sidebar-logout" asp-controller="Account" asp-action="Logout">
                    <span class="link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    </span>
                    <span class="link-text">Logout</span>
                </a>
            </div>
        </aside>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <div class="admin-content">

            <!-- TOP BAR -->
            <header class="admin-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" id="sidebarToggle" title="Toggle sidebar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>
                    <div>
                        <div class="topbar-title">@(ViewData["PageTitle"] ?? ViewData["Title"] ?? "Dashboard")</div>
                        <div class="topbar-breadcrumb">OneStop Mobile Repair › @(ViewData["PageTitle"] ?? ViewData["Title"] ?? "Dashboard")</div>
                    </div>
                </div>
                <div class="topbar-right">
                    <a asp-controller="Enquiries" asp-action="Index" class="notification-bell-wrap @(newEnquiryCount > 0 ? "notification-active bell-blink" : "")" title="@newEnquiryCount New Enquiries">
                        <svg class="notification-bell" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        @if (newEnquiryCount > 0)
                        {
                            <span class="bell-badge">@newEnquiryCount</span>
                        }
                    </a>
                    <div class="topbar-status-dot" title="System Online"></div>
                    <div class="topbar-user-info">
                        <div class="topbar-admin-name">@adminName</div>
                        <div class="topbar-admin-role">Super Admin</div>
                    </div>
                    <a asp-controller="Account" asp-action="Profile" title="Edit Profile" style="text-decoration:none; display:flex; align-items:center;">
                    @if (!string.IsNullOrEmpty(avatarUrl)) {
                        <img src="@avatarUrl" class="topbar-avatar" style="object-fit: cover; padding: 0; border: 2px solid var(--accent); cursor:pointer; transition: box-shadow 0.2s;" alt="Avatar" onmouseover="this.style.boxShadow='0 0 0 3px var(--accent)'" onmouseout="this.style.boxShadow='0 0 16px rgba(99,102,241,0.4)'" />
                    } else {
                        <div class="topbar-avatar" style="cursor:pointer; border: 2px solid var(--accent);">@avatarChar</div>
                    }
                    </a>
                </div>
            </header>

            <!-- PAGE BODY -->
            <main class="admin-main">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                <span>© @DateTime.Now.Year OneStop Mobile Repair, Morbi</span>
                <span class="footer-dot">·</span>
                <span>Admin Panel v2.0</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', () => {
            document.getElementById('adminSidebar').classList.toggle('collapsed');
            document.querySelector('.admin-content').classList.toggle('expanded');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
