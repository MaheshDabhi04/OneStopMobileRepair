@{
    ViewData["Title"] = "Our Services";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>
<div class="laser-line"></div>
<div class="progress-bar" id="progressBar"></div>
<div class="particles" id="particles"></div>

<!-- PAGE BANNER -->
<div class="page-banner">
    <div class="hero-bg-orb orb1"></div>
    <div class="hero-bg-orb orb2"></div>
    <p class="banner-eyebrow">What We Do</p>
    <h1>Our Services</h1>
    <p>Expert smartphone repair &mdash; from laser display solutions to software recovery, all under one roof.</p>
</div>

<!-- SERVICES GRID -->
<section class="os-section os-section-alt">
    <div style="max-width:700px; margin-bottom:3.5rem;">
        <span class="section-label">Complete Repair Solutions</span>
        <h2 class="section-title">What We <span>Offer</span></h2>
        <div class="divider"></div>
    </div>
    <div class="services-grid">
        <div class="service-card">
            <span class="service-icon">&#129001;</span>
            <div class="service-name">Green Line Remove</div>
            <div class="service-desc">Advanced laser-based green line removal &mdash; Morbi's first and finest solution for display line issues.</div>
            <span class="tag">Laser Tech</span>
        </div>
        <div class="service-card">
            <span class="service-icon">&#128421;</span>
            <div class="service-name">Green / White Display Solution</div>
            <div class="service-desc">Complete display fault diagnosis and repair for all smartphone models using cutting-edge technology.</div>
            <span class="tag">Display Expert</span>
        </div>
        <div class="service-card">
            <span class="service-icon">&#128300;</span>
            <div class="service-name">OCA Glass Change</div>
            <div class="service-desc">Optical clear adhesive glass replacement for crystal-clear, bubble-free screens every time.</div>
            <span class="tag">Precision</span>
        </div>
        <div class="service-card">
            <span class="service-icon">&#128241;</span>
            <div class="service-name">Original Display Replacement</div>
            <div class="service-desc">100% genuine display units for iPhone, Samsung &amp; all major brands &mdash; no compromises.</div>
            <span class="tag">Genuine Parts</span>
        </div>
        <div class="service-card">
            <span class="service-icon">&#128247;</span>
            <div class="service-name">Camera Problem Solve</div>
            <div class="service-desc">Blurry, black, or non-functional camera? We diagnose and fix camera issues fast.</div>
            <span class="tag">Camera Repair</span>
        </div>
        <div class="service-card">
            <span class="service-icon">&#128267;</span>
            <div class="service-name">Battery Replacement</div>
            <div class="service-desc">Restore full-day battery life with quality cell replacements for all major brands and models.</div>
            <span class="tag">Long Life</span>
        </div>
        <div class="service-card">
            <span class="service-icon">&#127822;</span>
            <div class="service-name">iPhone / Samsung Back Glass</div>
            <div class="service-desc">Premium back glass replacement &mdash; makes your phone look brand new again.</div>
            <span class="tag">Back Glass</span>
        </div>
        <div class="service-card">
            <span class="service-icon">&#128190;</span>
            <div class="service-name">Software Repair</div>
            <div class="service-desc">Flashing, unlocking, boot loops &mdash; software restored to perfection using professional tools.</div>
            <span class="tag">Software</span>
        </div>
    </div>
</section>

<!-- WHY CHOOSE US -->
<section class="os-section">
    <div style="max-width:700px; margin-bottom:3.5rem;">
        <span class="section-label">Our Edge</span>
        <h2 class="section-title">Why Choose <span>OneStop?</span></h2>
        <div class="divider"></div>
    </div>
    <div class="why-grid">
        <div class="why-card">
            <span class="why-icon">&#9889;</span>
            <div class="why-title">Laser Technology</div>
            <div class="why-desc">Morbi's first and only shop using advanced laser tech to remove green/white display lines permanently.</div>
        </div>
        <div class="why-card">
            <span class="why-icon">&#9989;</span>
            <div class="why-title">Genuine Parts Only</div>
            <div class="why-desc">We use 100% original display units, batteries, and components for lasting, reliable repairs.</div>
        </div>
        <div class="why-card">
            <span class="why-icon">&#128336;</span>
            <div class="why-title">Fast Turnaround</div>
            <div class="why-desc">Most repairs completed same day. We value your time as much as we value your device.</div>
        </div>
        <div class="why-card">
            <span class="why-icon">&#128737;</span>
            <div class="why-title">Repair Warranty</div>
            <div class="why-desc">All repairs come with a service warranty. We stand behind every job we do.</div>
        </div>
        <div class="why-card">
            <span class="why-icon">&#128176;</span>
            <div class="why-title">Transparent Pricing</div>
            <div class="why-desc">No hidden fees. You know the price before we begin &mdash; always honest, always fair.</div>
        </div>
        <div class="why-card">
            <span class="why-icon">&#128242;</span>
            <div class="why-title">All Brands Serviced</div>
            <div class="why-desc">iPhone, Samsung, Xiaomi, OnePlus, Oppo, Vivo &mdash; we fix them all with equal expertise.</div>
        </div>
    </div>
</section>

<!-- CTA BAND -->
<section class="os-section cta-band">
    <span class="section-label">Book Now</span>
    <h2 class="section-title">Ready to Fix Your <span>Device?</span></h2>
    <p class="cta-sub">Walk in or contact us &mdash; same-day service available for most repairs in Morbi.</p>
    <div class="cta-buttons">
        <a asp-controller="Website" asp-action="Contact" class="btn btn-primary">Contact Us</a>
        <a href="tel:+919033778500" class="btn btn-outline">&#128222; +91 90337 78500</a>
    </div>
</section>
