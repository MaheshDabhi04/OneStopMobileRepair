@model IEnumerable<OneStopMobileRepair.Models.Expense>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Expenses";
    ViewData["PageTitle"] = "Expense Management";
}

<style>
    /* Glassmorphism Summary Cards */
    .expense-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .stat-card {
        background: rgba(17, 24, 39, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        padding: 24px;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        border-color: rgba(99, 102, 241, 0.3);
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: -50px;
        right: -50px;
        width: 120px;
        height: 120px;
        background: radial-gradient(circle, var(--accent-color) 0%, transparent 70%);
        opacity: 0.15;
        border-radius: 50%;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        background: var(--accent-light);
        color: var(--accent-color);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 16px;
    }

    .stat-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        color: #fff;
        margin-top: 4px;
    }

    /* Refined Table Design */
    .expense-table-container {
        background: rgba(17, 24, 39, 0.8);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .custom-table th {
        background: rgba(255, 255, 255, 0.02);
        padding: 18px 24px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .custom-table td {
        padding: 16px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        vertical-align: middle;
        color: var(--text-primary);
    }

    .custom-table tr:hover td {
        background: rgba(255, 255, 255, 0.01);
    }

    .date-pill {
        display: inline-block;
        padding: 6px 12px;
        background: rgba(99, 102, 241, 0.1);
        color: #a5b4fc;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .amount-text {
        font-size: 16px;
        font-weight: 800;
        color: #fff;
    }

    /* Mobile Adaptivity */
    @@media (max-width: 768px) {
        .expense-stats {
            grid-template-columns: 1fr;
        }
        .custom-table th:nth-child(4),
        .custom-table td:nth-child(4) {
            padding-right: 12px;
        }
    }
</style>

<!-- Summary Stats -->
<div class="expense-stats">
    <div class="stat-card" style="--accent-color: #6366f1; --accent-light: rgba(99,102,241,0.12);">
        <div class="stat-icon">💸</div>
        <div class="stat-label">Today's Expense</div>
        <div class="stat-value">₹@ViewBag.DailyTotal</div>
    </div>
    <div class="stat-card" style="--accent-color: #10b981; --accent-light: rgba(16,185,129,0.12);">
        <div class="stat-icon">📅</div>
        <div class="stat-label">This Month's Total</div>
        <div class="stat-value">₹@ViewBag.MonthlyTotal</div>
    </div>
</div>

<!-- Header -->
<div class="page-header" style="margin-top: 0;">
    <div>
        <h2 style="font-weight: 800; letter-spacing: -0.5px;">📋 Expense Ledger</h2>
        <p style="opacity: 0.7;">Detailed tracking of product purchases & business costs</p>
    </div>
    <a href="/Expenses/Create" class="btn-admin btn-primary">➕ Record New Expense</a>
</div>

<!-- Main Table -->
<div class="expense-table-container">
    <table class="custom-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Product / Description</th>
                <th>Amount</th>
                <th style="width: 80px;">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" style="text-align:center; padding: 80px; opacity: 0.5;">
                        <div style="font-size: 48px; margin-bottom: 16px;">🍃</div>
                        <div style="font-weight: 600;">No expenses recorded yet.</div>
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <span class="date-pill">@item.ExpenseDate.ToString("dd MMM yyyy")</span>
                    </td>
                    <td>
                        <div style="font-weight: 700; font-size: 15px; color: #fff;">@item.ProductName</div>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">@item.Description</div>
                        }
                    </td>
                    <td>
                        <span class="amount-text">₹@item.Amount</span>
                    </td>
                    <td style="text-align: center;">
                        <a href="/Expenses/Delete/@item.Id" class="btn-admin btn-delete" style="padding:6px 12px; font-size:12px;">🗑 Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
