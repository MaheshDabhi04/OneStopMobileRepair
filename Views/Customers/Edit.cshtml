@model OneStopMobileRepair.Models.Customer

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Customer";
    ViewData["PageTitle"] = "Edit Customer";
}

<div class="page-header">
    <div>
        <h2>✏️ Edit Customer</h2>
        <p>Update repair job details for <strong>@Model.CustomerName</strong></p>
    </div>
    <a href="/Customers/Index" class="btn-admin btn-outline">← Back to Customers</a>
</div>

<div class="form-card">
    <div class="form-card-title">📋 Edit Repair Details</div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="EntryDate" />

        <div class="form-grid">

            <div class="form-group">
                <label>Customer Name *</label>
                <input asp-for="CustomerName" class="form-control-admin" placeholder="Full name" />
            </div>

            <div class="form-group">
                <label>Mobile Number</label>
                <input asp-for="MobileNumber" class="form-control-admin" placeholder="e.g. 9876543210" />
            </div>

            <div class="form-group">
                <label>Brand</label>
                <input asp-for="Brand" class="form-control-admin" placeholder="e.g. Samsung, Apple" />
            </div>

            <div class="form-group">
                <label>Model</label>
                <input asp-for="Model" class="form-control-admin" placeholder="e.g. Galaxy S21" />
            </div>

            <div class="form-group">
                <label>Problem</label>
                <input asp-for="Problem" class="form-control-admin" placeholder="e.g. Screen crack" />
            </div>

            <div class="form-group">
                <label>Device Password</label>
                <input asp-for="DevicePassword" class="form-control-admin" placeholder="e.g. 1234 or Pattern" />
            </div>

            <div class="form-group">
                <label>Status</label>
                <select asp-for="Status" class="form-control-admin">
                    <option value="Pending">⏳ Pending</option>
                    <option value="Unrepairable">❌ Unrepairable</option>
                    <option value="Completed">✅ Completed</option>
                    <option value="Delivered">📦 Delivered</option>
                </select>
            </div>

            <div class="form-group">
                <label>Deposit (₹)</label>
                <input asp-for="Deposit" class="form-control-admin" type="number" placeholder="0" />
            </div>

            <div class="form-group">
                <label>Delivery Date</label>
                @{
                    var minDateEdit = (Model?.CreditTime != null && Model.CreditTime < DateTime.Now) 
                        ? Model.CreditTime.Value.ToString("yyyy-MM-dd") 
                        : DateTime.Now.ToString("yyyy-MM-dd");
                }
                <input type="date" asp-for="CreditTime" min="@minDateEdit" class="form-control-admin" />
            </div>

            <div class="form-group">
                <label>Estimate (₹)</label>
                <input asp-for="Estimate" class="form-control-admin" type="number" placeholder="0" />
            </div>

        </div>

        <div class="form-actions">
            <button type="submit" class="btn-admin btn-primary">💾 Update Customer</button>
            <a href="/Customers/Details/@Model.Id" class="btn-admin btn-view">👁 View Details</a>
            <a href="/Customers/Index" class="btn-admin btn-outline">Cancel</a>
        </div>

    </form>
</div>