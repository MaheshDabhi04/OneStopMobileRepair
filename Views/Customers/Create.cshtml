@model OneStopMobileRepair.Models.Customer

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Customer";
    ViewData["PageTitle"] = "Add New Customer";
}

<div class="page-header">
    <div>
        <h2>➕ Add New Customer</h2>
        <p>Enter the repair job details for a new customer</p>
    </div>
    <a href="/Customers/Index" class="btn-admin btn-outline">← Back to Customers</a>
</div>

<div class="form-card">
    <div class="form-card-title">📋 Customer & Repair Details</div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="form-grid">

            <div class="form-group">
                <label>Customer Name *</label>
                <input asp-for="CustomerName" class="form-control-admin" placeholder="Enter full name" />
            </div>

            <div class="form-group">
                <label>Mobile Number</label>
                <input asp-for="MobileNumber" class="form-control-admin" placeholder="e.g. 9876543210" />
            </div>

            <div class="form-group">
                <label>Brand</label>
                <input asp-for="Brand" class="form-control-admin" placeholder="e.g. Samsung, Apple" />
            </div>

            <div class="form-group">
                <label>Model</label>
                <input asp-for="Model" class="form-control-admin" placeholder="e.g. Galaxy S21" />
            </div>

            <div class="form-group full-width">
                <label>Problem Description</label>
                <input asp-for="Problem" class="form-control-admin" placeholder="Describe the issue..." />
            </div>

            <div class="form-group">
                <label>Device Password / Pattern</label>
                <input asp-for="DevicePassword" class="form-control-admin" placeholder="Unlock code" />
            </div>

            <div class="form-group">
                <label>Status</label>
                <select asp-for="Status" class="form-control-admin">
                    <option value="">Select Status</option>
                    <option value="Pending">⏳ Pending</option>
                    <option value="Unrepairable">❌ Unrepairable</option>
                    <option value="Completed">✅ Completed</option>
                    <option value="Delivered">📦 Delivered</option>
                </select>
            </div>

            <div class="form-group">
                <label>Estimate (₹)</label>
                <input asp-for="Estimate" class="form-control-admin" type="number" placeholder="0" />
            </div>

            <div class="form-group">
                <label>Deposit (₹)</label>
                <input asp-for="Deposit" class="form-control-admin" type="number" placeholder="0" />
            </div>

            <div class="form-group">
                <label>Delivery Date</label>
                <input type="date" asp-for="CreditTime" class="form-control-admin" />
            </div>

        </div>

        <div class="form-actions">
            <button type="submit" class="btn-admin btn-primary">💾 Save Customer</button>
            <a href="/Customers/Index" class="btn-admin btn-outline">Cancel</a>
        </div>

    </form>
</div>